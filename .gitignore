# ===== 密钥与本地配置（公开仓库，绝不能提交）=====
.env
.env.*
!env.example
*.pem
*.key
*.p12
*.pfx
config.local.*
secrets.*

# ===== 日志与临时文件 =====
*.log
logs/
*.tmp
*.swp
*~

# ===== 客户材料与数据（含真实个人信息的，一律不入库）=====
inputs/**/*.pdf
inputs/**/*.jpg
inputs/**/*.jpeg
inputs/**/*.png
inputs/**/*.xlsx
!inputs/README.md
*.sql.gz
*.dump
backup/
backups/

# ===== 工作草稿与备份（保留文档，不保留中间件）=====
tmp/*_备份.md
tmp/recover*
tmp/*恢复版*
tmp/*.bak
*.bak

# ===== 第三方参考资料（体量大、非本项目产物）=====
