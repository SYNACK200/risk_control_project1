# Independent Demo template. Never reuse MySQL80 configuration/data.
[mysqld]
basedir=D:/RiskControlDemo/mysql84/server
datadir=D:/RiskControlDemo/mysql84/data
port=3307
bind-address=127.0.0.1
mysqlx=0
character-set-server=utf8mb4
collation-server=utf8mb4_0900_ai_ci
default-time-zone=+08:00
log-error=D:/RiskControlDemo/mysql84/logs/mysql84.err
general-log=OFF
slow-query-log=OFF
local-infile=OFF

[client]
host=127.0.0.1
port=3307
protocol=TCP
default-character-set=utf8mb4
